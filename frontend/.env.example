# Required for the standard deployment: frontend on Vercel, backend on
# Render. Set these as build-time env vars in the Vercel project settings
# to your deployed Render service URL, then redeploy.

VITE_API_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com

# Optional (local dev only): run this frontend against a deployed backend
# without changing its CORS config. Vite proxies /api and /socket.io to the
# target and presents VITE_DEV_PROXY_ORIGIN as the request origin. Pair with
# VITE_API_URL=/api and VITE_SOCKET_URL=/ in a .env.local file.
# VITE_DEV_PROXY_TARGET=https://your-backend.onrender.com
# VITE_DEV_PROXY_ORIGIN=https://your-app.vercel.app
