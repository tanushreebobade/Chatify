# Server
PORT=3000
NODE_ENV=development

# Database (MongoDB Atlas connection string recommended for production)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatify

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=onboarding@yourdomain.com
EMAIL_FROM_NAME=Chatify

# Arcjet (rate limiting / bot protection)
ARCJET_KEY=
ARCJET_ENV=production

# CORS / cookies — set to the deployed frontend origin, e.g. your Vercel
# deployment (no trailing slash): https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
